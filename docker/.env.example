# Copy to .env and fill in values. Never commit .env.
#
# DB_PASSWORD_EPI is passed into the Airflow containers so that BashOperator
# subprocesses (Rscript, dbt) can reach the epi_pipeline RDS database.
# It must match the value in your host ~/.Renviron.

DB_PASSWORD_EPI=your_db_password_here

# Airflow requires this to be set when running as non-root in Docker.
# Run: echo "AIRFLOW_UID=$(id -u)" >> .env
AIRFLOW_UID=50000
